# Copy to .env (never commit .env). Phase 1 needs no secrets or API keys.

# SQLite file location. Default: ./data/market.db (relative to the repo root).
# STI_DATABASE_URL=sqlite:///./data/market.db

# Directory holding the *.yaml config files. Default: ./config
# STI_CONFIG_DIR=./config

# Comma-separated origins allowed to call the API from a browser.
# STI_CORS_ORIGINS=http://localhost:5173
